---
import "../styles/global.css";
const {
    title = "pwnspirit",
    description = "pwnspirit — a 20 year old from Nepal who loves computers and software.",
} = Astro.props;
const path = Astro.url.pathname;
const active = (p) => (p === "/" ? path === "/" : path.startsWith(p));
const nav = [
    { href: "/blog", label: "blog" },
    { href: "/notes", label: "notes" },
    { href: "/gallery", label: "gallery" },
    { href: "/projects", label: "projects" },
    { href: "/contact", label: "contact" },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title === "pwnspirit" ? title : `${title} — pwnspirit`}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
        <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <link rel="icon" href="/favicon.ico" sizes="48x48" />
        <link rel="icon" href="/favicon.png" type="image/png" sizes="192x192" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta
            property="og:image"
            content={new URL("/profile.jpg", Astro.site ?? Astro.url)}
        />
        <link
            rel="alternate"
            type="application/rss+xml"
            title="pwnspirit"
            href="/rss.xml"
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap"
            rel="stylesheet"
        />
        <script is:inline>
            (function () {
                try {
                    var t = localStorage.getItem("theme");
                    if (t === "light" || t === "dark")
                        document.documentElement.setAttribute("data-theme", t);
                } catch (e) {}
            })();
        </script>
    </head>
    <body>
        <header class="site-header">
            <nav class="site-nav" aria-label="site">
                <a class="brand" href="/">
                    Home
                </a>
                <span class="spacer"></span>
                {nav.map((n) => (
                    <a
                        class="navlink"
                        href={n.href}
                        aria-current={active(n.href) ? "page" : undefined}
                    >
                        {n.label}
                    </a>
                ))}
                <button
                    id="theme"
                    class="theme-toggle"
                    aria-label="toggle theme"
                    title="toggle theme"
                >
                    <span class="t-moon">moon</span>
                    <span class="t-sun">sun</span>
                </button>
            </nav>
        </header>

        <main>
            <div class="wrap">
                <slot />
            </div>
        </main>

        <footer class="site-footer">
            <div class="wrap">
                <div class="foot-row">
                    <div class="foot-nav">
                        <a href="/">home</a>
                        <a href="/blog">blog</a>
                        <a href="/notes">notes</a>
                        <a href="/gallery">gallery</a>
                        <a href="/projects">projects</a>
                        <a href="/rss.xml">rss</a>
                    </div>
                    <div class="elsewhere">
                        <a
                            href="https://github.com/pwnspirit"
                            aria-label="github"
                            title="github"
                        >
                            <svg viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z" />
                            </svg>
                        </a>
                        <a
                            href="https://x.com/pwnspirit"
                            aria-label="x"
                            title="x"
                        >
                            <svg viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M12.6 0h2.45l-5.36 6.12L16 16h-4.94l-3.87-5.06L2.77 16H.32l5.73-6.55L0 0h5.06l3.5 4.63L12.6 0zm-.86 14.52h1.36L4.32 1.4H2.86l8.88 13.12z" />
                            </svg>
                        </a>
                        <a
                            href="https://linkedin.com/in/pwnspirit"
                            aria-label="linkedin"
                            title="linkedin"
                        >
                            <svg viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M13.63 13.63h-2.37V9.9c0-.89-.02-2.03-1.24-2.03-1.24 0-1.43.97-1.43 1.97v3.79H6.22V6h2.28v1.04h.03c.32-.6 1.1-1.24 2.26-1.24 2.41 0 2.86 1.59 2.86 3.66v4.17zM3.56 4.96a1.38 1.38 0 110-2.76 1.38 1.38 0 010 2.76zM4.75 13.63H2.37V6h2.38v7.63zM14.82 0H1.18C.53 0 0 .52 0 1.16v13.68C0 15.48.53 16 1.18 16h13.64c.65 0 1.18-.52 1.18-1.16V1.16C16 .52 15.47 0 14.82 0z" />
                            </svg>
                        </a>
                        <a
                            href="https://discord.com/users/936853051984199750"
                            aria-label="discord"
                            title="discord"
                        >
                            <svg viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M13.55 3.3A13.2 13.2 0 0010.27 2.28l-.16.33a12.2 12.2 0 00-4.22 0l-.16-.33A13.2 13.2 0 002.45 3.3C.37 6.4-.2 9.4.08 12.37a13.3 13.3 0 004.02 2.03l.86-1.4a8.6 8.6 0 01-1.35-.65l.33-.25a9.5 9.5 0 008.12 0l.33.25c-.43.26-.88.48-1.35.65l.86 1.4a13.3 13.3 0 004.02-2.03c.33-3.44-.57-6.41-2.37-9.07zM5.35 10.55c-.79 0-1.44-.72-1.44-1.62s.63-1.62 1.44-1.62c.8 0 1.45.73 1.44 1.62 0 .9-.64 1.62-1.44 1.62zm5.3 0c-.79 0-1.44-.72-1.44-1.62s.63-1.62 1.44-1.62c.8 0 1.45.73 1.44 1.62 0 .9-.63 1.62-1.44 1.62z" />
                            </svg>
                        </a>
                    </div>
                </div>
                <div class="copy">
                    &copy; {new Date().getFullYear()} pwnspirit
                </div>
            </div>
        </footer>

        <script is:inline>
            (function () {
                var root = document.documentElement;
                var btn = document.getElementById("theme");
                function current() {
                    var a = root.getAttribute("data-theme");
                    if (a) return a;
                    return matchMedia("(prefers-color-scheme:dark)").matches
                        ? "dark"
                        : "light";
                }
                btn &&
                    btn.addEventListener("click", function () {
                        var next = current() === "dark" ? "light" : "dark";
                        root.setAttribute("data-theme", next);
                        try {
                            localStorage.setItem("theme", next);
                        } catch (e) {}
                    });
            })();
        </script>
    </body>
</html>
